# IoT Risk Detection System Configuration

# Application Settings
DEBUG=False
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=sqlite:///data/iot_risk_detect.db

# Network Configuration
SCAN_NETWORK=192.168.1.0/24
SCAN_INTERFACE=eth0
SCAN_TIMEOUT=300
SCAN_RATE=1000

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# Dashboard Configuration
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501

# AI/ML Configuration
ANOMALY_THRESHOLD=0.8
MODEL_UPDATE_INTERVAL=3600
FEATURE_WINDOW_SIZE=100

# Notification Configuration
# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications (optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=admin@yourdomain.com

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/iot_risk_detect.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Security Configuration
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# CVE Database Configuration
CVE_UPDATE_INTERVAL=86400

# Monitoring Configuration
TRAFFIC_CAPTURE_INTERVAL=60
PACKET_BUFFER_SIZE=1000
MAX_PACKET_SIZE=65535

# Alert Configuration
ALERT_COOLDOWN=300
MAX_ALERTS_PER_HOUR=10 

